SUPABASE_URL=https://yourref.supabase.co
SUPABASE_PROJECT_REF=yourref
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALLOWED_ORIGIN=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Checkout return URLs (frontend). MEMBERSHIP_SUCCESS_URL may contain the
# literal {CHECKOUT_SESSION_ID} placeholder — Stripe fills it in.
MEMBERSHIP_SUCCESS_URL=http://localhost:3000/membership/success?session_id={CHECKOUT_SESSION_ID}
MEMBERSHIP_CANCEL_URL=http://localhost:3000/membership
# Maps each Stripe price id to the membership it grants. Edit per Stripe account.
STRIPE_PRICE_MAP={"price_full_digital":{"plan":"full","edition":"digital"},"price_full_print":{"plan":"full","edition":"print"},"price_supporting":{"plan":"supporting","edition":null}}
